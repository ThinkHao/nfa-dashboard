# NFA Dashboard 环境变量模板（推荐）
# 复制此文件为 .env 并按需修改

# 服务配置
APP_PORT=8081

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_password
DB_NAME=nfa_v2

# 鉴权配置
AUTH_SECRET=change_me
AUTH_ACCESS_TOKEN_TTL_MINUTES=60
AUTH_REFRESH_TOKEN_TTL_MINUTES=43200

# 兼容历史变量（可不配置）
# NFA_SERVER_PORT=8081
# NFA_DB_HOST=localhost
# NFA_DB_PORT=3306
# NFA_DB_USER=root
# NFA_DB_PASS=your_password
# NFA_DB_NAME=nfa_v2
