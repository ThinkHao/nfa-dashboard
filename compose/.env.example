# Backend
APP_PORT=8081
TRAFFIC_REPORT_STORAGE_DIR=/app/storage/traffic-reports
# Imported nfatool tasks can run on the native engine after parity validation.
TRAFFIC_REPORT_LEGACY_NATIVE_ENABLED=false
# Raw EDC source used by the native imported-task engine.
TRAFFIC_REPORT_EDC_HOST=
TRAFFIC_REPORT_EDC_PORT=3306
TRAFFIC_REPORT_EDC_USER=
TRAFFIC_REPORT_EDC_PASSWORD=
TRAFFIC_REPORT_EDC_DB=cloud
TRAFFIC_REPORT_EDC_TABLE=edc_data
TRAFFIC_REPORT_EDC_TIME_COLUMN=create_time
TRAFFIC_REPORT_EDC_NAME_COLUMN=edc_name
TRAFFIC_REPORT_EDC_VALUE_COLUMN=service_size
TRAFFIC_REPORT_EDC_EXCLUDE_LIKE=%-backup
TRAFFIC_REPORT_EDC_WILDCARD_MODE=prefix
TRAFFIC_REPORT_EDC_DAILY_RANK_INDEX=14
# Optional legacy nfatool compatibility bridge. Imported legacy tasks use this
# endpoint so their first-version exports keep the original output semantics.
TRAFFIC_REPORT_LEGACY_BASE_URL=
TRAFFIC_REPORT_LEGACY_API_KEY=

# External MySQL 5.7
DB_HOST=your.mysql.host
DB_PORT=3306
DB_USER=nfa
DB_PASS=your_password
DB_NAME=nfa

# Dev-only MySQL container (profiles: with-db)
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root

# Frontend
FRONTEND_PORT=8080
ENABLE_HTTPS=false
# 当 ENABLE_HTTPS=true 时：
# 1) 若 SSL_CERT_PATH/SSL_KEY_PATH 留空，将自动生成自签名证书到 compose/nginx/certs/
# 2) 由于离线 compose 仅映射一个前端端口，请将 FRONTEND_PORT 改为 443（或你需要的 HTTPS 端口）
SSL_CERT_PATH=
SSL_KEY_PATH=
SSL_CERT_CN=localhost
SSL_CERT_SANS=DNS:localhost,IP:127.0.0.1

# Auth
AUTH_SECRET=change_me_in_prod
AUTH_ACCESS_TOKEN_TTL_MINUTES=60
AUTH_REFRESH_TOKEN_TTL_MINUTES=43200

# Binding & Rates (comma-separated role names)
BINDING_ALLOWED_SALES_ROLES=Sales,Account
BINDING_ALLOWED_LINE_ROLES=Ops,Network
BINDING_ALLOWED_NODE_ROLES=NodeOps
BINDING_ALLOWED_CHANNEL_ROLES=Channel
RATES_OWNER_ROLES_CUSTOMER_FEE=Sales,Account
RATES_OWNER_ROLES_NETWORK_LINE_FEE=Ops,Network

# Security
CORS_ALLOWED_ORIGINS=http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=8
LOGIN_RATE_LIMIT_WINDOW_SECS=600
LOGIN_RATE_LIMIT_BLOCK_SECS=900

# Scheduler & Alert
# SCHEDULER_ENABLED=true
# ALERT_FEISHU_WEBHOOK_URL=

# IMAGE_TAG
IMAGE_TAG=v0.1.18
